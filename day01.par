def Main: ! = chan exit {
	catch e => {
		Debug.Log(String.Builder.add("Error: ").add(e).build)
		exit!
	}

	Parse.begin.case {
		.item(rot) parser => {
			Debug.Log(Rotation.ToString(rot))
			parser.loop
		},
		else try result => {},
	}

	exit!
}

dec Parse : ResultList<Os.Error, Rotation>
def Parse =
	catch e => .err e in
	Lines(type Os.Error)(String.ParserFromReader(type Os.Error)(Os.Stdin)).begin.case {
		.item(line) lines => let try parsed = Rotation.Parse(line) in .item(parsed) lines.loop,
		else try ! => .ok!,
	}

type Direction = either {
	.left!,
	.right!,
}
type Direction.Error = String

dec Direction.Parse : [String] Result<Direction.Error, Direction>
def Direction.Parse = [str]
	catch e => .err e in
	String.Equals(str, "L").case {
		.true! => .ok .left!,
		.false! => String.Equals(str, "R").case {
			.true! => .ok .right!,
			.false! => throw String.Builder.add("invalid direction ").add(str).build,
		},
	}

dec Direction.ToString : [Direction] String
def Direction.ToString = [dir]
	dir.case {
		.left! => "L",
		.right! => "R",
	}

type Rotation = (Direction) Nat
type Rotation.Error = String

dec Rotation.Parse : [String] Result<Rotation.Error, Rotation>
def Rotation.Parse = [str]
	catch e => .err e in
	String.Parser(str).char.case {
		.end try ! => throw "unexpected end of rotation",
		.char(c) parser => do {
			let r = Result.Always(type String)(parser.remainder)

			let try dir = Direction.Parse(c)
			let try amount = Nat.FromString(r).case {
				.ok amount => .ok amount,
				.err! => .err "invalid rotation amount",
			}
		} in .ok (dir) amount,
	}

dec Rotation.ToString : [Rotation] String
def Rotation.ToString = [(dir) amount]
	String.Builder
		.add(Direction.ToString(dir))
		.add(Nat.ToString(amount))
		.build

// ResultList<e, v> is simultaneously a List<v> and a Result<e, !>.
type ResultList<e, v> = recursive either {
	.ok!,
	.err e,
	.item(v) self,
}

dec Lines : [type e] [String.Parser<e>] ResultList<e, String>
def Lines = [type e] [parser]
	catch e => .err e in
	parser.begin.match(.repeat.one.any!, .str "\n").case {
		.end try ! => .ok !,
		.fail parser => let try r = parser.remainder in .item(r) .ok!,
		.match(line, _) parser => .item(line) parser.loop,
	}
